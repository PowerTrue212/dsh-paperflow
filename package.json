{
  "name": "dsh-paperflow",
  "version": "0.1.0",
  "type": "module",
  "description": "PaperFlow — a right-sidebar paper reader for DSH: reflowed bilingual reading of two-column PDFs and web articles.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "engine.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@napi-rs/canvas": "1.1.0",
    "cheerio": "^1.2.0",
    "katex": "0.16.22",
    "pdfjs-dist": "6.3.289"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "pdf",
    "paper",
    "reader",
    "translation",
    "katex"
  ],
  "author": "PowerTrue212",
  "repository": {
    "type": "git",
    "url": "https://github.com/PowerTrue212/dsh-paperflow.git"
  },
  "homepage": "https://github.com/PowerTrue212/dsh-paperflow#readme",
  "bugs": {
    "url": "https://github.com/PowerTrue212/dsh-paperflow/issues"
  }
}
